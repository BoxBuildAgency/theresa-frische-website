# Contact form email delivery (Resend) — required for the /contact form to send.
# Create these in Theresa's own Resend account, and set them in the Netlify UI
# (Site settings → Environment variables). Do NOT commit real values.

# API key from https://resend.com (Account → API Keys)
RESEND_API_KEY=

# Where enquiries are delivered (Theresa's inbox)
CONTACT_TO_EMAIL=info@theresafrische.com

# The "from" sender. MUST be an address on a domain verified in the Resend
# account (e.g. info@theresafrische.com). An unverified sender will fail to
# send in production. For an interim preview, Resend's onboarding sender
# (onboarding@resend.dev) may be used temporarily.
CONTACT_FROM_EMAIL=
